{
  "tasks": {
    "check": "deno check ./**/*.ts",
    "fmt": "deno fmt ./**/*.ts",
    "fmt:check": "deno fmt --check ./**/*.ts",
    "lint": "deno lint ./**/*.ts",
    "test:integration": "deno test --allow-all test/",
    "test:unit": "deno test --allow-env --allow-read denops/"
  },
  "lock": false,
  "fmt": {
    "exclude": ["CHANGELOG.md"]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
